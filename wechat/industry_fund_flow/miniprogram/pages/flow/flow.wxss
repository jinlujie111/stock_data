/* 左：概览/榜单  右：内容 */
.flow-page {
  display: flex;
  flex-direction: row;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  background: #0b1220;
}

.left-nav {
  width: 168rpx;
  flex-shrink: 0;
  background: #0a0f1a;
  border-right: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 16rpx 0;
  box-sizing: border-box;
}

.nav-item {
  padding: 28rpx 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8fa3bf;
  border-left: 6rpx solid transparent;
}

.nav-item.on {
  color: #4fd1c5;
  background: rgba(79, 209, 197, 0.08);
  border-left-color: #4fd1c5;
  font-weight: 600;
}

.right {
  flex: 1;
  min-width: 0;
  height: 100vh;
  box-sizing: border-box;
}

.right-scroll {
  height: 100%;
  box-sizing: border-box;
  padding-bottom: 32rpx;
}

/* 榜单内 净流入/吸筹/出货 */
.rank-sub-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 0 8rpx;
}

/* 从 index 复用 */
.date-card {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}
.date-picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.date-picker-val {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.picker-hint {
  font-size: 24rpx;
}

.date-shared-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.section-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.top10-summary {
  font-size: 24rpx;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.risk-note {
  margin-top: 8rpx;
}

.latent-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.latent-hint {
  margin-top: 16rpx;
}

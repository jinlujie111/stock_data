<view class="card" wx:if="{{user && user.logged_in}}">
  <view>昵称：{{user.nickname || '未设置'}}</view>
  <button class="btn btn-danger" style="margin-top:24rpx;" bindtap="logout">退出</button>
</view>
<view wx:else class="card">
  <button class="btn btn-primary" bindtap="mockLogin">模拟登录（dev_local_user）</button>
  <view class="muted" style="margin-top:16rpx;">生产环境请使用 wx.login + code 交换 token</view>
</view>

<view class="card" wx:if="{{detail}}">
  <view style="font-size:36rpx;font-weight:700;">{{detail.industry_name}}</view>
  <view class="muted">快照日 {{detail.trade_date}}</view>
  <view style="margin-top:24rpx;font-weight:600;">近20日净流入序列</view>
  <view class="muted" wx:for="{{detail.fund_trend_20d}}" wx:key="trade_date">
    {{item.trade_date}}　净流入 {{item.main_net_inflow}}　涨跌 {{item.chg_pct}}%
  </view>
  <view style="margin-top:24rpx;font-weight:600;">龙头股（占位/MVP）</view>
  <view class="cell" wx:for="{{detail.leaders}}" wx:key="stock_code">
    <view class="cell-row">
      <text class="cell-title">{{item.stock_name}}</text>
      <text class="cell-value">
        <block wx:if="{{item.chg_pct === '—'}}">—</block>
        <block wx:else>{{item.chg_pct}}%</block>
      </text>
    </view>
  </view>
</view>
<view wx:if="{{!loading && !detail}}" class="loading-wrap">暂无数据</view>
<view wx:if="{{loading}}" class="loading-wrap">加载中…</view>

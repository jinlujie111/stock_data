<view>
  <view class="notice">盘后为分析窗口，数据来自数仓行业资金流，仅供参考</view>

  <view class="card" wx:if="{{dash}}">
    <view class="muted">交易日 {{dash.trade_date}}</view>
    <view style="margin-top:16rpx;font-size:34rpx;font-weight:600;">资金主线 TOP10</view>
    <view class="cell" wx:for="{{dash.mainline_top10}}" wx:key="industry_name">
      <view class="cell-row">
        <text class="cell-title">{{item.industry_name}}</text>
        <text class="cell-value">{{item.main_net_inflow}}</text>
      </view>
      <view class="cell-label">涨幅 {{item.industry_change_pct}}%</view>
    </view>
  </view>

  <view class="card" wx:if="{{dash && dash.market}}">
    <view style="font-weight:600;margin-bottom:12rpx;">市场概览</view>
    <view class="muted">总成交额(亿元，近似)：{{dash.market.total_turnover_yi}}</view>
    <view class="muted">上涨行业数：{{dash.market.up_count}} 下跌：{{dash.market.down_count}}</view>
    <view class="accent" style="margin-top:8rpx;">{{dash.risk_note}}</view>
  </view>

  <view class="card" wx:if="{{latent}}">
    <view style="display:flex;justify-content:space-between;align-items:center;">
      <view style="font-weight:600;">次日潜伏</view>
      <text class="tag tag-on" wx:if="{{!latent.vip}}">预览 TOP{{latent.items.length}}</text>
    </view>
    <view class="cell" wx:for="{{latent.items}}" wx:key="industry_name">
      <view class="cell-row">
        <text class="cell-title">{{item.industry_name}}</text>
        <text class="cell-value">{{item.total_score}}</text>
      </view>
      <view class="cell-label">风险 {{item.risk_level}}</view>
    </view>
    <view class="muted" wx:if="{{latent.hint}}" style="margin-top:16rpx;">{{latent.hint}}</view>
  </view>

  <view wx:if="{{!loading && err}}" class="loading-wrap">{{err}}</view>
  <view wx:if="{{loading}}" class="loading-wrap">加载中…</view>

  <view style="padding: 32rpx;">
    <button class="btn btn-primary" bindtap="goRank">查看完整榜单</button>
    <view style="height:24rpx;"></view>
    <button class="btn btn-plain" bindtap="goVip">会员中心</button>
  </view>
</view>

/** 全局：金融科技深色风 + 原生组件配套样式（不依赖 Vant / miniprogram_npm） */
page {
  background: #0b1220;
  color: #e8eef7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
}
.card {
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #121a2b, #0f1626);
  border: 1px solid rgba(255, 255, 255, 0.06);
}
.muted { color: #8fa3bf; font-size: 24rpx; }
.accent { color: #4fd1c5; }

.notice {
  margin: 16rpx 24rpx;
  padding: 20rpx 24rpx;
  background: #121a2b;
  border-radius: 8rpx;
  color: #4fd1c5;
  font-size: 26rpx;
  border: 1px solid rgba(79, 209, 197, 0.2);
}

.cell {
  display: flex;
  flex-direction: column;
  padding: 24rpx 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
.cell:last-child { border-bottom: none; }
.cell-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cell-title { font-size: 28rpx; max-width: 60%; }
.cell-value { font-size: 28rpx; color: #4fd1c5; }
.cell-label { font-size: 24rpx; color: #8fa3bf; margin-top: 8rpx; }

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #8fa3bf;
}
.tag-on {
  background: rgba(79, 209, 197, 0.2);
  color: #4fd1c5;
}

button.btn::after {
  border: none;
}
.btn {
  margin: 0;
  padding: 22rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  line-height: 1.4;
}
.btn-primary {
  background: linear-gradient(90deg, #2dd4bf, #0d9488);
  color: #0b1220;
}
.btn-plain {
  background: transparent;
  color: #4fd1c5;
  border: 1px solid rgba(79, 209, 197, 0.5);
}
.btn-danger {
  background: rgba(239, 68, 68, 0.25);
  color: #fca5a5;
}

.loading-wrap {
  padding: 48rpx;
  text-align: center;
  color: #8fa3bf;
  font-size: 26rpx;
}

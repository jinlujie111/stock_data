# 复制为 .env 后修改
APP_NAME=industry-fund-flow-api
DEBUG=0
SECRET_KEY=change-me-to-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# 若留空或删掉此行，Pydantic 可能读到空密码导致 1045；请填写与 MySQL 一致的密码
MYSQL_PASSWORD=jinlujie
MYSQL_DATABASE=stock_data

# 可选 Redis；留空则内存简易缓存不启用
REDIS_URL=

# 业务：行业资金流「即时」口径 period_type
PERIOD_INSTANT=即时
WECHAT_APPID=
WECHAT_SECRET=

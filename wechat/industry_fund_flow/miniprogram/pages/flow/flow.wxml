<view class="flow-page">
  <view class="left-nav">
    <view
      class="nav-item {{panel==='overview'?'on':''}}"
      data-panel="overview"
      bindtap="onPanel"
    >概览</view>
    <view
      class="nav-item {{panel==='latent'?'on':''}}"
      data-panel="latent"
      bindtap="onPanel"
    >次日潜伏</view>
    <view
      class="nav-item {{panel==='rank'?'on':''}}"
      data-panel="rank"
      bindtap="onPanel"
    >榜单</view>
  </view>

  <scroll-view class="right right-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="notice">盘后为分析窗口，数据来自数仓行业资金流，仅供参考</view>

    <view class="card date-card">
      <picker
        mode="date"
        value="{{tradeDate || dateEnd}}"
        start="{{dateStart}}"
        end="{{dateEnd}}"
        bindchange="onTradeDateChange"
      >
        <view class="date-picker-row">
          <text class="muted">交易日</text>
          <view class="date-picker-val">
            <text class="accent">{{tradeDate || '加载中…'}}</text>
            <text class="muted picker-hint"> 点击打开日历 ›</text>
          </view>
        </view>
      </picker>
      <view class="muted date-shared-hint">概览、次日潜伏与榜单均使用该交易日</view>
    </view>

    <!-- ========== 概览 ========== -->
    <block wx:if="{{panel==='overview'}}">
      <view class="card" wx:if="{{dash}}">
        <view class="section-title">资金主线 TOP10</view>
        <view class="top10-summary muted" wx:if="{{dash.industry_summary}}">
          上涨行业 {{dash.industry_summary.up_count}} 家 · 下跌 {{dash.industry_summary.down_count}} 家
        </view>
        <view class="cell" wx:for="{{dash.mainline_top10}}" wx:key="industry_name">
          <view class="cell-row">
            <text class="cell-title">{{item.industry_name}}</text>
            <text class="cell-value">{{item.main_net_inflow}}</text>
          </view>
          <view class="cell-label">涨幅 {{item.chg_pct}}%</view>
        </view>
      </view>

      <view class="card" wx:if="{{dash && dash.market}}">
        <view class="section-title">市场概览</view>
        <view class="muted">总成交额(亿元，近似)：{{dash.market.total_turnover_yi}}</view>
        <view class="muted">上涨行业数：{{dash.market.up_count}} 下跌：{{dash.market.down_count}}</view>
        <view class="accent risk-note">{{dash.risk_note}}</view>
      </view>

      <view wx:if="{{!loading && err}}" class="loading-wrap">{{err}}</view>
      <view wx:if="{{loading}}" class="loading-wrap">加载中…</view>
    </block>

    <!-- ========== 次日潜伏 ========== -->
    <block wx:if="{{panel==='latent'}}">
      <view wx:if="{{loading && !latent}}" class="loading-wrap">加载中…</view>
      <view class="card" wx:if="{{latent}}">
        <view class="latent-head">
          <view class="section-title">次日潜伏</view>
        </view>
        <view class="cell" wx:for="{{latent.items}}" wx:key="industry_name">
          <view class="cell-row">
            <text class="cell-title">{{item.industry_name}}</text>
            <text class="cell-value">{{item.total_score}}</text>
          </view>
          <view class="cell-label">风险 {{item.risk_level}}</view>
        </view>
        <view class="muted latent-hint" wx:if="{{latent.hint}}">{{latent.hint}}</view>
      </view>
      <view wx:if="{{loading}}" class="loading-wrap">加载中…</view>
    </block>

    <!-- ========== 榜单 ========== -->
    <block wx:if="{{panel==='rank'}}">
      <view class="card">
        <view class="rank-sub-tabs">
          <text class="tag {{tab===0?'tag-on':''}}" data-tab="0" bindtap="onChangeTab">净流入</text>
          <text class="tag {{tab===1?'tag-on':''}}" data-tab="1" bindtap="onChangeTab">连续吸筹</text>
          <text class="tag {{tab===2?'tag-on':''}}" data-tab="2" bindtap="onChangeTab">出货预警</text>
        </view>

        <view wx:if="{{tab===0}}">
          <view
            class="cell"
            wx:for="{{inflow}}"
            wx:key="industry_name"
            data-name="{{item.industry_name}}"
            bindtap="openDetail"
          >
            <view class="cell-row">
              <text class="cell-title">{{item.industry_name}}</text>
              <text class="cell-value">{{item.main_net_inflow}} ›</text>
            </view>
          </view>
        </view>

        <view wx:if="{{tab===1}}">
          <view
            class="cell"
            wx:for="{{acc}}"
            wx:key="industry_name"
            data-name="{{item.industry_name}}"
            bindtap="openDetail"
          >
            <view class="cell-row">
              <text class="cell-title">{{item.industry_name}}</text>
              <text class="cell-value">{{item.main_net_inflow}} ›</text>
            </view>
            <view class="cell-label">连续{{item.streak_days}}日净流入</view>
          </view>
        </view>

        <view wx:if="{{tab===2}}">
          <view class="cell" wx:for="{{exit}}" wx:key="industry_name">
            <view class="cell-row">
              <text class="cell-title">{{item.industry_name}}</text>
              <text class="cell-value">{{item.main_net_inflow}}</text>
            </view>
            <view class="cell-label">{{item.reason}}</view>
          </view>
        </view>

        <view wx:if="{{rankLoading}}" class="loading-wrap">加载中…</view>
      </view>
    </block>
  </scroll-view>
</view>
